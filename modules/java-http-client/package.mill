package build.modules.`java-http-client`

import scala.util.Properties

import mill.api.Task
import mill.scalalib.{DepSyntax, ScalaModule}

private val sharedTestOnlyDeps = Seq(
  mvn"com.lihaoyi::ujson::4.4.3",
  mvn"com.lihaoyi::os-lib::0.11.8",
  mvn"org.http4s::http4s-dsl::1.0.0-M47",
  mvn"org.http4s::http4s-ember-server::1.0.0-M47",
)

private val testApiVersions = Seq(21, 25) // minimum supported API versions for testing

object `package` extends build.CommonModule:
  upper =>

  def artifactName = "scala-native-java-http-client"

  def moduleDeps = Seq(
    build.modules.core,
    build.modules.curl,
    build.modules.openssl,
  )

  def mvnDeps = Seq(
    mvn"io.github.cquiroz::scala-java-locales::1.5.4",
    mvn"io.github.cquiroz::scala-java-time::2.6.0",
    mvn"com.github.lolgab::scala-native-crypto::0.4.0",
  )

  override def sources = Task.Sources(
    moduleDir / "src",
    moduleDir / (if Properties.isLinux then "src-epoll" else "src-plain"),
  )

  object test extends ScalaNativeTests with build.UTestModule:

    // Avoid loading jointly compiled java.* shim classes in the JVM test discoverer.
    override def discoverTestsWithZinc = true

    def nativeLinkingOptions =
      (
        if Properties.isMac
        then
          Seq(s"-L${
              if Properties.propOrEmpty("os.arch") == "aarch64"
              then "/opt/homebrew"
              else "/usr/local"
            }/opt/curl/lib")
        else Seq.empty
      ) ++ super.nativeLinkingOptions()

    def mvnDeps = sharedTestOnlyDeps

    def sources = Task.Sources(
      (
        Seq(
          // Compile versioned API shims jointly so they take precedence over the host JDK.
          upper.moduleDir / "src" / "java" / "net" / "http",
          upper.moduleDir / "src" / "java" / "net" / "URL.scala",
          moduleDir / "src", // modules/java-http-client/test/src
          moduleDir / "src-native", // modules/java-http-client/test/src-native
        )
          ++ testApiVersions.map(version => moduleDir / s"src-jdk${version}")
          // modules/java-http-client/test/src-jdk??
      )*,
    )

  end test

  val upperModuleTestDir = test.moduleDir

  object jvm extends ScalaModule:

    def scalaVersion = build.scalaVersion
    def sources = Seq() // no sources for JVM

    object test extends ScalaTests with build.UTestModule:

      def mvnDeps = sharedTestOnlyDeps ++ Seq(
        // BC kits are Java only deps
        mvn"org.bouncycastle:bcutil-jdk18on:1.83",
        mvn"org.bouncycastle:bcpkix-jdk18on:1.83",
      )

      def sources = Task.Sources(
        (
          Seq(
            upperModuleTestDir / "src", // modules/java-http-client/test/src
            upperModuleTestDir / "src-jvm", // modules/java-http-client/test/src-jvm
          )
            ++ testApiVersions
              .filter(Properties.isJavaAtLeast)
              .map(version => upperModuleTestDir / s"src-jdk${version}")
            ++ (if Properties.isJavaAtLeast(21)
                then Seq.empty
                else Seq(upperModuleTestDir / "src-jvm-pre21"))
        )*,
      )

      def resources = Task.Sources(
        upperModuleTestDir / "resources", // modules/java-http-client/test/resources
      )

  end jvm

end `package`
